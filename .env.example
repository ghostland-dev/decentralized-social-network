# Nostr Social Network Configuration

# Node Environment
NODE_ENV=production

# Application URL
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Nostr Relays (comma-separated)
NEXT_PUBLIC_NOSTR_RELAYS=wss://relay.damus.io,wss://relay.nostr.band,wss://nos.lol,wss://relay.snort.social

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false

# Cache Configuration (in milliseconds)
NEXT_PUBLIC_PROFILE_CACHE_TTL=600000
NEXT_PUBLIC_EVENT_CACHE_TTL=300000

# Pagination
NEXT_PUBLIC_POSTS_PER_PAGE=20
NEXT_PUBLIC_MESSAGES_PER_PAGE=50

# Rate Limiting
NEXT_PUBLIC_MAX_POSTS_PER_MINUTE=10
NEXT_PUBLIC_MAX_MESSAGES_PER_MINUTE=30

# WebLN Configuration (optional)
NEXT_PUBLIC_ENABLE_WEBLN=true

# Sentry DSN (optional)
SENTRY_DSN=

# Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=